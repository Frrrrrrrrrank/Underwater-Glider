typedef struct
{
  uint8_t initialized;
  uint8_t rr_index;
  int32_t last_sent_speed_rpm[MOTOR_BUS_MAX_NODES];
  uint32_t last_cmd_tick[MOTOR_BUS_MAX_NODES];
  uint32_t last_poll_tick[MOTOR_BUS_MAX_NODES];
  uint8_t last_motor_enable[MOTOR_BUS_MAX_NODES];
} MotorInternal;

static MotorInternal g_motor_internal = {
  0U, 0U, {0}, {0U}, {0U}, {0U}
};

static uint16_t Motor_Crc16(const uint8_t *data, uint16_t len)
{
  uint16_t crc = 0xFFFFU;
  uint16_t i;
  uint8_t bit;

  for (i = 0U; i < len; i++)
  {
    crc ^= data[i];
    for (bit = 0U; bit < 8U; bit++)
    {
      if ((crc & 0x0001U) != 0U)
      {
        crc = (uint16_t)((crc >> 1) ^ 0xA001U);
      }
      else
      {
        crc >>= 1;
      }
    }
  }

  return crc;
}

static uint8_t Motor_BuildWriteSingleRegFrame(uint8_t node_id,
                                               uint16_t reg_addr,
                                               uint16_t reg_value,
                                               uint8_t *frame)
{
  uint16_t crc;

  frame[0] = node_id;
  frame[1] = 0x06U; /* Write single register */
  frame[2] = (uint8_t)((reg_addr >> 8) & 0xFFU);
  frame[3] = (uint8_t)(reg_addr & 0xFFU);
  frame[4] = (uint8_t)((reg_value >> 8) & 0xFFU);
  frame[5] = (uint8_t)(reg_value & 0xFFU);

  crc = Motor_Crc16(frame, 6U);
  frame[6] = (uint8_t)(crc & 0xFFU);
  frame[7] = (uint8_t)((crc >> 8) & 0xFFU);

  return 8U;
}

static uint16_t Motor_BuildReadStatusFrame(uint8_t node_id,
                                           uint16_t start_reg,
                                           uint16_t reg_count,
                                           uint8_t *frame)
{
  uint16_t crc;

  frame[0] = node_id;
  frame[1] = 0x03U; /* Read holding registers */
  frame[2] = (uint8_t)((start_reg >> 8) & 0xFFU);
  frame[3] = (uint8_t)(start_reg & 0xFFU);
  frame[4] = (uint8_t)((reg_count >> 8) & 0xFFU);
  frame[5] = (uint8_t)(reg_count & 0xFFU);

  crc = Motor_Crc16(frame, 6U);
  frame[6] = (uint8_t)(crc & 0xFFU);
  frame[7] = (uint8_t)((crc >> 8) & 0xFFU);

  return 8U;
}

static uint8_t Motor_ReceiveExact(uint8_t *buffer, uint16_t expected_len, uint32_t timeout_ms)
{
  uint16_t index;
  HAL_StatusTypeDef rx_status;

  if (buffer == NULL || expected_len == 0U)
  {
    return 0U;
  }

  for (index = 0U; index < expected_len; index++)
  {
    rx_status = HAL_UART_Receive(MOTOR_RS485_UART, &buffer[index], 1U, timeout_ms);
    if (rx_status != HAL_OK)
    {
      return 0U;
    }
  }

  return 1U;
}

static uint8_t Motor_Transfer(const uint8_t *tx_frame,
                              uint16_t tx_len,
                              uint8_t *rx_frame,
                              uint16_t rx_capacity,
                              uint16_t *rx_got_len)
{
  HAL_StatusTypeDef tx_status;
  uint8_t header[3];
  uint16_t byte_count;
  uint16_t expected_len;
  uint8_t transfer_ok = 0U;

  if (tx_frame == NULL || rx_frame == NULL || rx_got_len == NULL || tx_len == 0U || rx_capacity == 0U)
  {
    g_motor_bus_diag.last_error = 1U;
    return 0U;
  }

  *rx_got_len = 0U;
  g_motor_bus_diag.last_rx_len = 0U;
  g_motor_bus_diag.last_error = 0U;

  tx_status = HAL_UART_Transmit(MOTOR_RS485_UART, (uint8_t *)tx_frame, tx_len, MOTOR_UART_TX_TIMEOUT_MS);
  if (tx_status != HAL_OK)
  {
    g_motor_bus_diag.last_error = 2U;
    goto transfer_exit;
  }

  g_motor_bus_diag.total_tx_count++;
  g_motor_bus_diag.last_tx_len = tx_len;
  if (tx_len > sizeof(g_motor_bus_diag.last_tx_frame))
  {
    tx_len = (uint16_t)sizeof(g_motor_bus_diag.last_tx_frame);
  }
  memcpy((void *)g_motor_bus_diag.last_tx_frame, tx_frame, tx_len);

  /*
   * HAL_UART_Transmit() returns after TC and hardware RS485 DE is released.
   * Listen immediately: at 115200 baud an 8-byte reply lasts only about 0.7 ms.
   */

  /* Read the fixed header first: addr + func + bytecount/exception code. */
  if (Motor_ReceiveExact(header, 3U, MOTOR_UART_RX_TIMEOUT_MS) == 0U)
  {
    g_motor_bus_diag.total_timeout_count++;
    g_motor_bus_diag.last_error = 3U;
    goto transfer_exit;
  }

  rx_frame[0] = header[0];
  rx_frame[1] = header[1];
  rx_frame[2] = header[2];

  if ((header[1] & 0x80U) != 0U)
  {
    expected_len = 5U;
  }
  else if (header[1] == 0x06U)
  {
    expected_len = 8U;
  }
  else
  {
    byte_count = header[2];
    expected_len = (uint16_t)(3U + byte_count + 2U);
  }

  if (expected_len > rx_capacity)
  {
    g_motor_bus_diag.last_error = 20U;
    goto transfer_exit;
  }

  if (expected_len > 3U)
  {
    if (Motor_ReceiveExact(&rx_frame[3], (uint16_t)(expected_len - 3U), MOTOR_UART_RX_TIMEOUT_MS) == 0U)
    {
      g_motor_bus_diag.total_timeout_count++;
      g_motor_bus_diag.last_error = 3U;
      goto transfer_exit;
    }
  }

  *rx_got_len = expected_len;
  g_motor_bus_diag.total_rx_count++;
  g_motor_bus_diag.last_rx_len = expected_len;
  if (expected_len > (uint16_t)sizeof(g_motor_bus_diag.last_rx_frame))
  {
    expected_len = (uint16_t)sizeof(g_motor_bus_diag.last_rx_frame);
  }
  memcpy((void *)g_motor_bus_diag.last_rx_frame, rx_frame, expected_len);

  transfer_ok = 1U;

transfer_exit:
  return transfer_ok;
}

static uint8_t Motor_IsExactWriteAck(const uint8_t *tx_frame,
                                     uint16_t tx_len,
                                     const uint8_t *rx_frame,
                                     uint16_t rx_len)
{
  if (tx_frame == NULL || rx_frame == NULL || tx_len != 8U || rx_len != tx_len)
  {
    return 0U;
  }

  return (memcmp(rx_frame, tx_frame, tx_len) == 0) ? 1U : 0U;
}

static uint8_t Motor_ParseStatusResponse(uint8_t node_id,
                                         const uint8_t *rx_frame,
                                         uint16_t rx_len,
                                         uint16_t expected_reg_count,
                                         uint16_t status_word_index,
                                         uint16_t speed_word_index,
                                         uint16_t *status_word,
                                         int16_t *feedback_speed)
{
  uint16_t byte_count_expected;
  uint16_t status_byte_pos;
  uint16_t speed_byte_pos;
  uint16_t recv_crc;
  uint16_t calc_crc;

  if (expected_reg_count == 0U || expected_reg_count > 16U)
  {
    g_motor_bus_diag.last_error = 13U;
    return 0U;
  }

  byte_count_expected = (uint16_t)(expected_reg_count * 2U);

  if (rx_len < (uint16_t)(5U + byte_count_expected))
  {
    g_motor_bus_diag.last_error = 7U;
    return 0U;
  }

  if (rx_frame[0] != node_id || rx_frame[1] != 0x03U || rx_frame[2] != (uint8_t)byte_count_expected)
  {
    g_motor_bus_diag.total_protocol_error_count++;
    g_motor_bus_diag.last_error = 8U;
    return 0U;
  }

  recv_crc = (uint16_t)(((uint16_t)rx_frame[(uint16_t)(4U + byte_count_expected)] << 8) |
                        rx_frame[(uint16_t)(3U + byte_count_expected)]);
  calc_crc = Motor_Crc16(rx_frame, (uint16_t)(3U + byte_count_expected));
  if (recv_crc != calc_crc)
  {
    g_motor_bus_diag.total_crc_error_count++;
    g_motor_bus_diag.last_error = 9U;
    return 0U;
  }

  if (status_word_index >= expected_reg_count || speed_word_index >= expected_reg_count)
  {
    g_motor_bus_diag.last_error = 14U;
    return 0U;
  }

  status_byte_pos = (uint16_t)(3U + status_word_index * 2U);
  speed_byte_pos = (uint16_t)(3U + speed_word_index * 2U);

  *status_word = (uint16_t)(((uint16_t)rx_frame[status_byte_pos] << 8) |
                            rx_frame[(uint16_t)(status_byte_pos + 1U)]);
  *feedback_speed = (int16_t)(((uint16_t)rx_frame[speed_byte_pos] << 8) |
                              rx_frame[(uint16_t)(speed_byte_pos + 1U)]);
  return 1U;
}

static uint8_t Motor_ParseReadBlockResponse(uint8_t node_id,
                                            const uint8_t *rx_frame,
                                            uint16_t rx_len,
                                            uint16_t max_out_words,
                                            uint16_t *out_words,
                                            uint16_t *out_reg_count)
{
  uint16_t i;
  uint16_t byte_count;
  uint16_t parsed_reg_count;
  uint16_t recv_crc;
  uint16_t calc_crc;

  if (max_out_words == 0U || max_out_words > 16U || out_words == NULL || out_reg_count == NULL)
  {
    g_motor_bus_diag.last_error = 16U;
    return 0U;
  }

  if (rx_len < 5U)
  {
    g_motor_bus_diag.last_error = 17U;
    return 0U;
  }

  byte_count = rx_frame[2];
  if ((byte_count == 0U) || ((byte_count & 0x01U) != 0U) || (byte_count > 32U))
  {
    g_motor_bus_diag.total_protocol_error_count++;
    g_motor_bus_diag.last_error = 18U;
    return 0U;
  }

  parsed_reg_count = (uint16_t)(byte_count / 2U);
  if (parsed_reg_count > max_out_words)
  {
    g_motor_bus_diag.total_protocol_error_count++;
    g_motor_bus_diag.last_error = 18U;
    return 0U;
  }

  if (rx_len < (uint16_t)(5U + byte_count))
  {
    g_motor_bus_diag.last_error = 17U;
    return 0U;
  }

  if (rx_frame[0] != node_id || rx_frame[1] != 0x03U)
  {
    g_motor_bus_diag.total_protocol_error_count++;
    g_motor_bus_diag.last_error = 18U;
    return 0U;
  }

  recv_crc = (uint16_t)(((uint16_t)rx_frame[(uint16_t)(4U + byte_count)] << 8) |
                        rx_frame[(uint16_t)(3U + byte_count)]);
  calc_crc = Motor_Crc16(rx_frame, (uint16_t)(3U + byte_count));
  if (recv_crc != calc_crc)
  {
    g_motor_bus_diag.total_crc_error_count++;
    g_motor_bus_diag.last_error = 19U;
    return 0U;
  }

  for (i = 0U; i < parsed_reg_count; i++)
  {
    out_words[i] = (uint16_t)(((uint16_t)rx_frame[(uint16_t)(3U + i * 2U)] << 8) |
                              rx_frame[(uint16_t)(4U + i * 2U)]);
  }

  *out_reg_count = parsed_reg_count;

  return 1U;
}

static uint32_t Motor_BaudCodeToBps(uint16_t baud_code)
{
  switch (baud_code)
  {
    case 0U: return 9600U;
    case 1U: return 14400U;
    case 2U: return 19200U;
    case 3U: return 38400U;
    case 4U: return 115200U;
    case 5U: return 128000U;
    case 6U: return 256000U;
    default: return 0U;
  }
}

static uint8_t Motor_ParseExceptionResponse(uint8_t node_id,
                                            const uint8_t *rx_frame,
                                            uint16_t rx_len,
                                            uint8_t *exception_func,
                                            uint8_t *exception_code)
{
  uint16_t recv_crc;
  uint16_t calc_crc;

  if (rx_len < 5U)
  {
    return 0U;
  }

  if (rx_frame[0] != node_id)
  {
    return 0U;
  }

  if ((rx_frame[1] & 0x80U) == 0U)
  {
    return 0U;
  }

  recv_crc = (uint16_t)(((uint16_t)rx_frame[4] << 8) | rx_frame[3]);
  calc_crc = Motor_Crc16(rx_frame, 3U);
  if (recv_crc != calc_crc)
  {
    g_motor_bus_diag.total_crc_error_count++;
    g_motor_bus_diag.last_error = 10U;
    return 0U;
  }

  *exception_func = rx_frame[1] & 0x7FU;
  *exception_code = rx_frame[2];
  return 1U;
}

static void Motor_UpdateActiveNodeCount(void)
{
  uint32_t active = 0U;
  uint8_t i;

  for (i = 0U; i < MOTOR_BUS_MAX_NODES; i++)
  {
    if (g_motor_nodes[i].enabled != 0U)
    {
      active++;
    }
  }

  g_motor_bus_diag.active_node_count = active;
}

void UMotor_SetNodeEnabled(uint8_t slot, uint8_t node_id, uint8_t enabled)
{
  if (slot >= MOTOR_BUS_MAX_NODES)
  {
    return;
  }

  g_motor_nodes[slot].node_id = node_id;
  g_motor_nodes[slot].enabled = (enabled != 0U) ? 1U : 0U;
  if (enabled == 0U)
  {
    g_motor_nodes[slot].valid = 0U;
    g_motor_nodes[slot].comm_ok = 0U;
  }
}

void UMotor_SetNodeSpeedControl(uint8_t slot, uint8_t enable_speed_ctrl)
{
  if (slot >= UMOTOR_NODE_COUNT)
  {
    return;
  }

  g_motor_nodes[slot].enable_speed_ctrl = (enable_speed_ctrl != 0U) ? 1U : 0U;
}

void UMotor_SetNodePollEnabled(uint8_t slot, uint8_t enable_poll)
{
  if (slot >= UMOTOR_NODE_COUNT)
  {
    return;
  }

  g_motor_nodes[slot].enable_poll = (enable_poll != 0U) ? 1U : 0U;
}

uint8_t UMotor_SetNodeRegisterMap(uint8_t slot, const UMotorNodeRegisterMap *map)
{
  if (slot >= UMOTOR_NODE_COUNT || map == NULL)
  {
    return 0U;
  }

  if (map->verify_read_reg_count == 0U || map->verify_read_reg_count > UMOTOR_MAX_READ_REG_COUNT ||
      map->status_read_reg_count > UMOTOR_MAX_READ_REG_COUNT ||
      map->fault_read_reg_count > UMOTOR_MAX_READ_REG_COUNT)
  {
    return 0U;
  }

  g_motor_nodes[slot].reg_map = *map;
  return 1U;
}
#define MOTOR_LIMIT_MASK_POSITIVE 0x01U
#define MOTOR_LIMIT_MASK_NEGATIVE 0x02U

static uint8_t Motor_GetLimitMask(void)
{
  uint8_t mask = 0U;

  if (g_limit_switch_states[1] == 0U)
  {
    mask |= MOTOR_LIMIT_MASK_POSITIVE;
  }
  if (g_limit_switch_states[3] == 0U)
  {
    mask |= MOTOR_LIMIT_MASK_NEGATIVE;
  }

  return mask;
}

/* PB4/state[1] blocks +RPM; PD7/state[3] blocks -RPM. */
static uint8_t Motor_IsLimitBlocked(int32_t rpm)
{
  uint8_t limit_mask = Motor_GetLimitMask();

  if ((rpm > 0) &&
      ((limit_mask & MOTOR_LIMIT_MASK_POSITIVE) != 0U))
  {
    return 1U; /* +RPM，PB4，limit_bits=13 */
  }

  if ((rpm < 0) &&
      ((limit_mask & MOTOR_LIMIT_MASK_NEGATIVE) != 0U))
  {
    return 1U; /* -RPM，PD7，limit_bits=7 */
  }

  return 0U;
}

static int8_t Motor_SpeedDirection(int32_t rpm)
{
  if (rpm > 0)
  {
    return 1;
  }
  if (rpm < 0)
  {
    return -1;
  }
  return 0;
}

static uint8_t Motor_DirectionMask(int32_t rpm)
{
  if (rpm > 0)
  {
    return MOTOR_LIMIT_MASK_POSITIVE;
  }
  if (rpm < 0)
  {
    return MOTOR_LIMIT_MASK_NEGATIVE;
  }
  return 0U;
}

static uint8_t Motor_IsNodeDirectionBlocked(
    volatile UMotorNodeState *node,
    int32_t rpm)
{
  if (Motor_IsLimitBlocked(rpm) != 0U)
  {
    return 1U;
  }

  if (node != NULL &&
      ((node->limit_latched_mask |
        node->limit_ack_required_mask) &
       Motor_DirectionMask(rpm)) != 0U)
  {
    return 1U;
  }

  return 0U;
}

static void Motor_LatchLimitEvent(volatile UMotorNodeState *node,
                                  int32_t blocked_rpm)
{
  int8_t direction;
  uint8_t direction_mask;
  uint8_t raw_limit_mask;

  if (node == NULL)
  {
    return;
  }

  direction = Motor_SpeedDirection(blocked_rpm);
  direction_mask = Motor_DirectionMask(blocked_rpm);
  if (direction == 0)
  {
    return;
  }

  raw_limit_mask = Motor_GetLimitMask();
  taskENTER_CRITICAL();
  node->limit_latched_mask |= direction_mask;
  node->limit_ack_required_mask |= direction_mask;
  if ((raw_limit_mask & MOTOR_LIMIT_MASK_POSITIVE) != 0U)
  {
    node->limit_positive_release_since_tick = 0U;
  }
  if ((raw_limit_mask & MOTOR_LIMIT_MASK_NEGATIVE) != 0U)
  {
    node->limit_negative_release_since_tick = 0U;
  }
  if (node->limit_event_pending == 0U)
  {
    node->limit_trip_direction = direction;
    node->limit_event_sequence++;
    node->limit_event_pending = 1U;
  }
  taskEXIT_CRITICAL();
}

void UMotor_SetTargetSpeedById(uint8_t node_id, int32_t target_speed_rpm)
{
  uint8_t i;
  uint8_t limit_blocked;
  int8_t request_direction;
  volatile UMotorNodeState *node;

  if (target_speed_rpm > 32767)
  {
    target_speed_rpm = 32767;
  }
  if (target_speed_rpm < -32768)
  {
    target_speed_rpm = -32768;
  }

  request_direction = Motor_SpeedDirection(target_speed_rpm);

  for (i = 0U; i < UMOTOR_NODE_COUNT; i++)
  {
    if ((g_motor_nodes[i].enabled != 0U) &&
        (g_motor_nodes[i].node_id == node_id))
    {
      node = &g_motor_nodes[i];

      /* Publish one coherent application intent and a sticky limit event. */
      taskENTER_CRITICAL();
      if (node->target_speed_rpm != target_speed_rpm)
      {
        node->command_sequence++;
      }
      node->target_speed_rpm = target_speed_rpm;
      if (target_speed_rpm == 0)
      {
        node->limit_ack_required_mask = 0U;
      }
      limit_blocked = Motor_IsNodeDirectionBlocked(
          node, target_speed_rpm);
      if (limit_blocked != 0U)
      {
        node->limit_latched_mask |=
            Motor_DirectionMask(target_speed_rpm);
        node->limit_ack_required_mask |=
            Motor_DirectionMask(target_speed_rpm);
        if (node->limit_request_blocked == 0U &&
            node->limit_event_pending == 0U)
        {
          node->limit_trip_direction = request_direction;
          node->limit_event_sequence++;
          node->limit_event_pending = 1U;
        }
        node->limit_request_blocked = 1U;
      }
      else
      {
        node->limit_request_blocked = 0U;
      }
      taskEXIT_CRITICAL();

      break;
    }
  }
}

typedef enum
{
  MOTOR_WRITE_TRANSFER_FAILED = 0,
  MOTOR_WRITE_ACK_OK = 1,
  MOTOR_WRITE_ACK_INVALID = 2
} MotorWriteResult;

typedef enum
{
  MOTOR_LIMIT_FLOW_NORMAL = 0,
  MOTOR_LIMIT_FLOW_BLOCK_COMMANDS = 1,
  MOTOR_LIMIT_FLOW_RETURN = 2
} MotorLimitFlowResult;

static MotorWriteResult Motor_WriteSingleRegisterExact(
    uint8_t node_id,
    uint16_t reg,
    uint16_t value,
    uint8_t tx_frame[8],
    uint8_t *rx_frame,
    uint16_t rx_capacity,
    uint16_t *tx_len,
    uint16_t *rx_len)
{
  *tx_len = Motor_BuildWriteSingleRegFrame(
      node_id, reg, value, tx_frame);

  if (Motor_Transfer(tx_frame,
                     *tx_len,
                     rx_frame,
                     rx_capacity,
                     rx_len) == 0U)
  {
    return MOTOR_WRITE_TRANSFER_FAILED;
  }

  if (Motor_IsExactWriteAck(tx_frame, *tx_len, rx_frame, *rx_len) != 0U)
  {
    return MOTOR_WRITE_ACK_OK;
  }

  g_motor_bus_diag.total_protocol_error_count++;
  g_motor_bus_diag.last_error = 21U; /* FC06 response was not an exact echo. */
  return MOTOR_WRITE_ACK_INVALID;
}

static void Motor_RecordSafetyWriteFailure(
    volatile UMotorNodeState *node,
    MotorWriteResult write_result)
{
  if (write_result == MOTOR_WRITE_TRANSFER_FAILED)
  {
    if (g_motor_bus_diag.last_error == 3U)
    {
      node->timeout_count++;
    }
    else
    {
      node->transport_error_count++;
    }
  }
  else
  {
    node->protocol_error_count++;
  }
  node->comm_ok = 0U;
}

static void Motor_RearmLimitEvent(volatile UMotorNodeState *node)
{
  taskENTER_CRITICAL();
  if (Motor_IsNodeDirectionBlocked(
          node, node->limit_recover_speed_rpm) != 0U)
  {
    node->limit_latched_mask |=
        Motor_DirectionMask(node->limit_recover_speed_rpm);
    node->limit_ack_required_mask |=
        Motor_DirectionMask(node->limit_recover_speed_rpm);
  }
  node->limit_event_pending = 1U;
  taskEXIT_CRITICAL();
}

static uint8_t Motor_IsRecoveryIntentValidUnsafe(
    volatile UMotorNodeState *node)
{
  int32_t recover_speed;

  recover_speed = node->limit_recover_speed_rpm;
  if (node->motor_enable == 0U ||
      node->limit_event_pending != 0U ||
      node->limit_event_sequence != node->limit_recover_sequence ||
      node->command_sequence != node->limit_recover_command_sequence ||
      node->target_speed_rpm != recover_speed ||
      recover_speed == 0 ||
      Motor_IsNodeDirectionBlocked(node, recover_speed) != 0U)
  {
    return 0U;
  }

  return 1U;
}

static uint8_t Motor_IsRecoveryIntentValid(
    volatile UMotorNodeState *node)
{
  uint8_t valid;

  taskENTER_CRITICAL();
  valid = Motor_IsRecoveryIntentValidUnsafe(node);
  taskEXIT_CRITICAL();
  return valid;
}

static void Motor_UpdateLimitLatchDebounce(
    volatile UMotorNodeState *node,
    uint32_t now_tick)
{
  uint8_t raw_limit_mask;
  uint8_t new_limit_mask;

  raw_limit_mask = Motor_GetLimitMask();
  taskENTER_CRITICAL();
  new_limit_mask =
      (uint8_t)(raw_limit_mask & (uint8_t)~node->limit_latched_mask);
  if (new_limit_mask != 0U)
  {
    node->limit_latched_mask |= new_limit_mask;
    node->limit_ack_required_mask |= new_limit_mask;
    node->limit_event_sequence++;
    node->limit_event_pending = 1U;
  }

  if ((raw_limit_mask & MOTOR_LIMIT_MASK_POSITIVE) != 0U)
  {
    node->limit_positive_release_since_tick = 0U;
  }
  else if ((node->limit_latched_mask & MOTOR_LIMIT_MASK_POSITIVE) != 0U)
  {
    if (node->limit_positive_release_since_tick == 0U)
    {
      node->limit_positive_release_since_tick = now_tick;
    }
    else if ((now_tick - node->limit_positive_release_since_tick) >=
             MOTOR_LIMIT_RELEASE_DEBOUNCE_MS)
    {
      node->limit_latched_mask &=
          (uint8_t)~MOTOR_LIMIT_MASK_POSITIVE;
      node->limit_positive_release_since_tick = 0U;
    }
  }
  else
  {
    node->limit_positive_release_since_tick = 0U;
  }

  if ((raw_limit_mask & MOTOR_LIMIT_MASK_NEGATIVE) != 0U)
  {
    node->limit_negative_release_since_tick = 0U;
  }
  else if ((node->limit_latched_mask & MOTOR_LIMIT_MASK_NEGATIVE) != 0U)
  {
    if (node->limit_negative_release_since_tick == 0U)
    {
      node->limit_negative_release_since_tick = now_tick;
    }
    else if ((now_tick - node->limit_negative_release_since_tick) >=
             MOTOR_LIMIT_RELEASE_DEBOUNCE_MS)
    {
      node->limit_latched_mask &=
          (uint8_t)~MOTOR_LIMIT_MASK_NEGATIVE;
      node->limit_negative_release_since_tick = 0U;
    }
  }
  else
  {
    node->limit_negative_release_since_tick = 0U;
  }

  if (node->limit_latched_mask == MOTOR_LIMIT_MASK_POSITIVE)
  {
    node->limit_trip_direction = 1;
  }
  else if (node->limit_latched_mask == MOTOR_LIMIT_MASK_NEGATIVE)
  {
    node->limit_trip_direction = -1;
  }
  else
  {
    node->limit_trip_direction = 0;
  }
  taskEXIT_CRITICAL();
}

void UMotor_ObserveLimitInputs(void)
{
  uint8_t index;
  uint8_t raw_limit_mask;
  uint8_t new_limit_mask;
  volatile UMotorNodeState *node;

  raw_limit_mask = Motor_GetLimitMask();
  if (raw_limit_mask == 0U)
  {
    return;
  }

  taskENTER_CRITICAL();
  for (index = 0U; index < MOTOR_BUS_MAX_NODES; index++)
  {
    node = &g_motor_nodes[index];
    if (node->enabled == 0U)
    {
      continue;
    }

    new_limit_mask =
        (uint8_t)(raw_limit_mask & (uint8_t)~node->limit_latched_mask);
    node->limit_latched_mask |= raw_limit_mask;
    /*
     * A zero-speed/disable acknowledgement must remain valid while the
     * mechanical switch is still held.  Only a newly observed limit edge
     * creates a new acknowledgement requirement.  A later blocked command
     * in UMotor_SetTargetSpeedById() re-arms the same direction explicitly.
     */
    node->limit_ack_required_mask |= new_limit_mask;
    if ((raw_limit_mask & MOTOR_LIMIT_MASK_POSITIVE) != 0U)
    {
      node->limit_positive_release_since_tick = 0U;
    }
    if ((raw_limit_mask & MOTOR_LIMIT_MASK_NEGATIVE) != 0U)
    {
      node->limit_negative_release_since_tick = 0U;
    }
    if (new_limit_mask != 0U)
    {
      node->limit_event_sequence++;
      node->limit_event_pending = 1U;
    }
  }
  taskEXIT_CRITICAL();
}

static MotorLimitFlowResult Motor_ProcessLimitSafetyState(
    uint8_t index,
    volatile UMotorNodeState *node,
    uint32_t now_tick)
{
  uint8_t tx_frame[8];
  uint8_t rx_frame[64];
  uint16_t tx_len = 0U;
  uint16_t rx_len = 0U;
  int32_t candidate_speed;
  uint32_t candidate_sequence;
  uint32_t candidate_command_sequence;
  MotorWriteResult write_result;

  /* Capture both raw limit directions in every safety phase. */
  Motor_UpdateLimitLatchDebounce(node, now_tick);

  if (node->limit_state == UMOTOR_LIMIT_STATE_NORMAL)
  {
    if (Motor_IsNodeDirectionBlocked(
            node, node->last_started_speed_rpm) != 0U)
    {
      Motor_LatchLimitEvent(node, node->last_started_speed_rpm);
    }

    if (node->limit_event_pending != 0U)
    {
      node->stop_mode = MOTOR_STOP_CMD_EMERGENCY;
      node->trigger_stop_cmd = 1U;
      node->run_restore_required = 1U;
      node->run_restore_acked = 0U;
      node->trigger_pos_cmd = 0U;
      node->position_transaction_active = 0U;
      node->limit_state = UMOTOR_LIMIT_STATE_STOP_PENDING;
    }
    else
    {
      return MOTOR_LIMIT_FLOW_NORMAL;
    }
  }

  switch (node->limit_state)
  {
    case UMOTOR_LIMIT_STATE_STOP_PENDING:
      node->trigger_stop_cmd = 1U;
      /* STOP may execute even when its ACK is lost. Never bypass RUN restore. */
      node->run_restore_required = 1U;
      node->run_restore_acked = 0U;
      if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
          MOTOR_CMD_MIN_INTERVAL_MS)
      {
        return MOTOR_LIMIT_FLOW_RETURN;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node->node_id,
          MOTOR_REG_STOP,
          MOTOR_STOP_CMD_EMERGENCY,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        node->trigger_stop_cmd = 0U;
        node->last_started_speed_rpm = 0;
        g_motor_internal.last_sent_speed_rpm[index] = 0;
        node->limit_state = UMOTOR_LIMIT_STATE_RELEASE_PENDING;
        node->limit_stop_ok_count++;
        node->comm_ok = 1U;
      }
      else
      {
        node->limit_stop_fail_count++;
        Motor_RecordSafetyWriteFailure(node, write_result);
      }
      g_motor_internal.last_cmd_tick[index] = now_tick;
      return MOTOR_LIMIT_FLOW_RETURN;

    case UMOTOR_LIMIT_STATE_RELEASE_PENDING:
      if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
          MOTOR_CMD_MIN_INTERVAL_MS)
      {
        return MOTOR_LIMIT_FLOW_RETURN;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node->node_id,
          MOTOR_REG_ENABLE,
          0U,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        g_motor_internal.last_motor_enable[index] = 0U;
        node->applied_enable = 0U;
        node->applied_enable_known = 1U;
        node->last_started_speed_rpm = 0;
        node->limit_state = UMOTOR_LIMIT_STATE_RELEASED;
        node->limit_release_ok_count++;
        node->comm_ok = 1U;
      }
      else
      {
        node->applied_enable_known = 0U;
        node->limit_release_fail_count++;
        Motor_RecordSafetyWriteFailure(node, write_result);
      }
      g_motor_internal.last_cmd_tick[index] = now_tick;
      return MOTOR_LIMIT_FLOW_RETURN;

    case UMOTOR_LIMIT_STATE_RELEASED:
      if (node->motor_enable == 0U &&
          node->target_speed_rpm == 0 &&
          node->limit_latched_mask == 0U)
      {
        taskENTER_CRITICAL();
        if (node->motor_enable == 0U &&
            node->target_speed_rpm == 0 &&
            node->limit_latched_mask == 0U)
        {
          node->limit_event_pending = 0U;
          node->limit_request_blocked = 0U;
          node->limit_trip_direction = 0;
          node->limit_ack_required_mask = 0U;
          node->limit_state = UMOTOR_LIMIT_STATE_NORMAL;
        }
        taskEXIT_CRITICAL();
        if (node->limit_state == UMOTOR_LIMIT_STATE_NORMAL)
        {
          return MOTOR_LIMIT_FLOW_NORMAL;
        }
      }

      candidate_speed = node->target_speed_rpm;
      if (node->motor_enable != 0U &&
          candidate_speed != 0 &&
          Motor_IsNodeDirectionBlocked(node, candidate_speed) == 0U)
      {
        taskENTER_CRITICAL();
        candidate_speed = node->target_speed_rpm;
        candidate_sequence = node->limit_event_sequence;
        candidate_command_sequence = node->command_sequence;
        if (node->motor_enable != 0U &&
            candidate_speed != 0 &&
            Motor_IsNodeDirectionBlocked(node, candidate_speed) == 0U)
        {
          node->limit_recover_speed_rpm = candidate_speed;
          node->limit_recover_sequence = candidate_sequence;
          node->limit_recover_command_sequence =
              candidate_command_sequence;
          node->limit_event_pending = 0U;
          node->limit_state =
              UMOTOR_LIMIT_STATE_RECOVER_RUN_PENDING;
        }
        taskEXIT_CRITICAL();

        return MOTOR_LIMIT_FLOW_RETURN;
      }
      return MOTOR_LIMIT_FLOW_BLOCK_COMMANDS;

    case UMOTOR_LIMIT_STATE_RECOVER_RUN_PENDING:
      if (Motor_IsRecoveryIntentValid(node) == 0U)
      {
        Motor_RearmLimitEvent(node);
        node->limit_state = UMOTOR_LIMIT_STATE_RELEASED;
        return MOTOR_LIMIT_FLOW_RETURN;
      }
      if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
          MOTOR_CMD_MIN_INTERVAL_MS)
      {
        return MOTOR_LIMIT_FLOW_RETURN;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node->node_id,
          MOTOR_REG_STOP,
          MOTOR_STOP_CMD_RUN,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        node->run_restore_required = 0U;
        node->run_restore_acked = 1U;
        node->run_restore_ok_count++;
        node->comm_ok = 1U;
        if (Motor_IsRecoveryIntentValid(node) != 0U)
        {
          node->limit_state =
              UMOTOR_LIMIT_STATE_RECOVER_ENABLE_PENDING;
        }
        else
        {
          Motor_RearmLimitEvent(node);
          node->limit_state = UMOTOR_LIMIT_STATE_RELEASED;
          node->limit_recover_fail_count++;
        }
      }
      else
      {
        node->run_restore_required = 1U;
        node->run_restore_acked = 0U;
        node->run_restore_fail_count++;
        Motor_RecordSafetyWriteFailure(node, write_result);
        /* Keep the motor released and retry 0x0038=2 on the next cycle. */
      }
      g_motor_internal.last_cmd_tick[index] = now_tick;
      return MOTOR_LIMIT_FLOW_RETURN;

    case UMOTOR_LIMIT_STATE_RECOVER_ENABLE_PENDING:
      if (Motor_IsRecoveryIntentValid(node) == 0U)
      {
        Motor_RearmLimitEvent(node);
        node->limit_state = UMOTOR_LIMIT_STATE_RELEASED;
        return MOTOR_LIMIT_FLOW_RETURN;
      }
      if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
          MOTOR_CMD_MIN_INTERVAL_MS)
      {
        return MOTOR_LIMIT_FLOW_RETURN;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node->node_id,
          MOTOR_REG_ENABLE,
          1U,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        g_motor_internal.last_motor_enable[index] = 1U;
        node->applied_enable = 1U;
        node->applied_enable_known = 1U;
        node->comm_ok = 1U;
        if (Motor_IsRecoveryIntentValid(node) != 0U)
        {
          node->limit_state =
              UMOTOR_LIMIT_STATE_RECOVER_SPEED_PENDING;
        }
        else
        {
          Motor_RearmLimitEvent(node);
          node->limit_state = UMOTOR_LIMIT_STATE_RELEASE_PENDING;
          node->limit_recover_fail_count++;
        }
      }
      else
      {
        node->applied_enable_known = 0U;
        Motor_RecordSafetyWriteFailure(node, write_result);
        Motor_RearmLimitEvent(node);
        node->limit_state = UMOTOR_LIMIT_STATE_RELEASE_PENDING;
        node->limit_recover_fail_count++;
      }
      g_motor_internal.last_cmd_tick[index] = now_tick;
      return MOTOR_LIMIT_FLOW_RETURN;

    case UMOTOR_LIMIT_STATE_RECOVER_SPEED_PENDING:
      if (Motor_IsRecoveryIntentValid(node) == 0U)
      {
        Motor_RearmLimitEvent(node);
        node->limit_state = UMOTOR_LIMIT_STATE_RELEASE_PENDING;
        return MOTOR_LIMIT_FLOW_RETURN;
      }
      if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
          MOTOR_CMD_MIN_INTERVAL_MS)
      {
        return MOTOR_LIMIT_FLOW_RETURN;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node->node_id,
          node->reg_map.reg_cmd_speed_rpm,
          (uint16_t)(int16_t)node->limit_recover_speed_rpm,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK &&
          Motor_IsRecoveryIntentValid(node) != 0U)
      {
        node->limit_state = UMOTOR_LIMIT_STATE_RECOVER_START_PENDING;
        node->comm_ok = 1U;
      }
      else
      {
        if (write_result != MOTOR_WRITE_ACK_OK)
        {
          Motor_RecordSafetyWriteFailure(node, write_result);
        }
        Motor_RearmLimitEvent(node);
        node->limit_state = UMOTOR_LIMIT_STATE_RELEASE_PENDING;
        node->limit_recover_fail_count++;
      }
      g_motor_internal.last_cmd_tick[index] = now_tick;
      return MOTOR_LIMIT_FLOW_RETURN;

    case UMOTOR_LIMIT_STATE_RECOVER_START_PENDING:
      if (Motor_IsRecoveryIntentValid(node) == 0U)
      {
        Motor_RearmLimitEvent(node);
        node->limit_state = UMOTOR_LIMIT_STATE_RELEASE_PENDING;
        return MOTOR_LIMIT_FLOW_RETURN;
      }
      if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
          MOTOR_CMD_MIN_INTERVAL_MS)
      {
        return MOTOR_LIMIT_FLOW_RETURN;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node->node_id,
          node->reg_map.reg_cmd_start,
          node->reg_map.cmd_start_speed_mode_value,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        g_motor_internal.last_sent_speed_rpm[index] =
            node->limit_recover_speed_rpm;
        node->last_started_speed_rpm = node->limit_recover_speed_rpm;
        node->comm_ok = 1U;

        taskENTER_CRITICAL();
        if (Motor_IsRecoveryIntentValidUnsafe(node) != 0U)
        {
          node->limit_state = UMOTOR_LIMIT_STATE_NORMAL;
          node->limit_recover_ok_count++;
        }
        else
        {
          if (Motor_IsNodeDirectionBlocked(
                  node, node->limit_recover_speed_rpm) != 0U)
          {
            node->limit_latched_mask |=
                Motor_DirectionMask(node->limit_recover_speed_rpm);
            node->limit_ack_required_mask |=
                Motor_DirectionMask(node->limit_recover_speed_rpm);
          }
          node->limit_event_pending = 1U;
          node->trigger_stop_cmd = 1U;
          node->limit_state = UMOTOR_LIMIT_STATE_STOP_PENDING;
          node->limit_recover_fail_count++;
        }
        taskEXIT_CRITICAL();
      }
      else
      {
        Motor_RecordSafetyWriteFailure(node, write_result);
        Motor_RearmLimitEvent(node);
        node->trigger_stop_cmd = 1U;
        node->limit_state = UMOTOR_LIMIT_STATE_STOP_PENDING;
        node->limit_recover_fail_count++;
      }
      g_motor_internal.last_cmd_tick[index] = now_tick;
      return MOTOR_LIMIT_FLOW_RETURN;

    default:
      Motor_LatchLimitEvent(
          node,
          (node->last_started_speed_rpm != 0)
              ? node->last_started_speed_rpm
              : node->target_speed_rpm);
      node->trigger_stop_cmd = 1U;
      node->limit_state = UMOTOR_LIMIT_STATE_STOP_PENDING;
      return MOTOR_LIMIT_FLOW_RETURN;
  }
}

static uint8_t Motor_IsNormalSpeedIntentValidUnsafe(
    volatile UMotorNodeState *node,
    int32_t speed_rpm,
    uint32_t command_sequence)
{
  if (node->limit_state != UMOTOR_LIMIT_STATE_NORMAL ||
      node->limit_event_pending != 0U ||
      node->trigger_stop_cmd != 0U ||
      node->motor_enable == 0U ||
      node->target_speed_rpm != speed_rpm ||
      node->command_sequence != command_sequence ||
      Motor_IsNodeDirectionBlocked(node, speed_rpm) != 0U)
  {
    return 0U;
  }
  return 1U;
}

static uint8_t Motor_IsNormalSpeedIntentValid(
    volatile UMotorNodeState *node,
    int32_t speed_rpm,
    uint32_t command_sequence)
{
  uint8_t valid;

  taskENTER_CRITICAL();
  valid = Motor_IsNormalSpeedIntentValidUnsafe(
      node, speed_rpm, command_sequence);
  taskEXIT_CRITICAL();
  return valid;
}

static uint8_t Motor_IsPositionIntentValidUnsafe(
    volatile UMotorNodeState *node,
    int32_t pulses,
    uint16_t speed_rpm,
    uint8_t is_absolute,
    int32_t direction_speed_rpm,
    uint32_t command_sequence)
{
  if (node->limit_state != UMOTOR_LIMIT_STATE_NORMAL ||
      node->limit_event_pending != 0U ||
      node->trigger_stop_cmd != 0U ||
      node->motor_enable == 0U ||
      node->pos_cmd_pulses != pulses ||
      node->pos_cmd_speed_rpm != speed_rpm ||
      node->pos_cmd_is_absolute != is_absolute ||
      node->command_sequence != command_sequence ||
      Motor_IsNodeDirectionBlocked(node, direction_speed_rpm) != 0U)
  {
    return 0U;
  }
  return 1U;
}

static uint8_t Motor_IsPositionIntentValid(
    volatile UMotorNodeState *node,
    int32_t pulses,
    uint16_t speed_rpm,
    uint8_t is_absolute,
    int32_t direction_speed_rpm,
    uint32_t command_sequence)
{
  uint8_t valid;

  taskENTER_CRITICAL();
  valid = Motor_IsPositionIntentValidUnsafe(
      node,
      pulses,
      speed_rpm,
      is_absolute,
      direction_speed_rpm,
      command_sequence);
  taskEXIT_CRITICAL();
  return valid;
}

static void Motor_FinishPositionTransaction(
    volatile UMotorNodeState *node)
{
  taskENTER_CRITICAL();
  node->trigger_pos_cmd = 0U;
  node->position_transaction_active = 0U;
  taskEXIT_CRITICAL();
}

static void Motor_RequestStopAfterSpeedTransaction(
    volatile UMotorNodeState *node,
    int32_t possible_speed_rpm)
{
  uint8_t direction_blocked;
  int8_t direction;

  direction = Motor_SpeedDirection(possible_speed_rpm);
  taskENTER_CRITICAL();
  direction_blocked = Motor_IsNodeDirectionBlocked(
      node, possible_speed_rpm);
  if (direction_blocked != 0U && direction != 0)
  {
    node->limit_latched_mask |=
        Motor_DirectionMask(possible_speed_rpm);
    node->limit_ack_required_mask |=
        Motor_DirectionMask(possible_speed_rpm);
    if (node->limit_event_pending == 0U)
    {
      node->limit_trip_direction = direction;
      node->limit_event_sequence++;
      node->limit_event_pending = 1U;
    }
  }

  node->stop_mode = MOTOR_STOP_CMD_EMERGENCY;
  node->trigger_stop_cmd = 1U;
  node->run_restore_required = 1U;
  node->run_restore_acked = 0U;
  node->trigger_pos_cmd = 0U;
  node->position_transaction_active = 0U;
  if (direction_blocked != 0U ||
      node->limit_event_pending != 0U ||
      node->limit_state != UMOTOR_LIMIT_STATE_NORMAL)
  {
    node->limit_state = UMOTOR_LIMIT_STATE_STOP_PENDING;
  }
  taskEXIT_CRITICAL();
}

static void Motor_ProcessOneNode(uint8_t index, uint32_t now_tick)
{
  uint8_t tx_frame[8];
  uint8_t rx_frame[64];
  uint16_t tx_len;
  uint16_t rx_len;
  int16_t speed_cmd;
  uint16_t status_word;
  int16_t feedback_speed;
  uint16_t block_words[16];
  uint16_t got_regs;
  uint16_t req_start_reg;
  uint16_t req_count;
  uint16_t copy_count;
  uint32_t command_sequence;
  int32_t possible_speed_rpm;
  int32_t position_pulses;
  int32_t position_direction_speed_rpm;
  uint16_t position_speed_rpm;
  uint16_t position_start_cmd;
  uint8_t poll_ok;
  uint8_t exception_func;
  uint8_t exception_code;
  uint8_t enable_cmd;
  uint8_t position_is_absolute;
  uint8_t node_id;
  volatile UMotorNodeState *node;
  volatile UMotorNodeDebugInfo *dbg;
  MotorWriteResult write_result;
  MotorLimitFlowResult limit_flow;

  if (index >= MOTOR_BUS_MAX_NODES || g_motor_nodes[index].enabled == 0U)
  {
    return;
  }

  node = &g_motor_nodes[index];
  dbg = &node->debug;
  node_id = node->node_id;

  limit_flow = Motor_ProcessLimitSafetyState(index, node, now_tick);
  if (limit_flow == MOTOR_LIMIT_FLOW_RETURN)
  {
    return;
  }

  /* Manual STOP remains available outside the automatic limit state machine. */
  if (limit_flow == MOTOR_LIMIT_FLOW_NORMAL &&
      g_motor_enable_write_cmd != 0U &&
      node->trigger_stop_cmd != 0U)
  {
    if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
        MOTOR_CMD_MIN_INTERVAL_MS)
    {
      return;
    }

    if (node->stop_mode != MOTOR_STOP_CMD_RUN)
    {
      /* Treat a sent STOP as effective even if the response is lost. */
      node->run_restore_required = 1U;
      node->run_restore_acked = 0U;
    }

    write_result = Motor_WriteSingleRegisterExact(
        node_id,
        MOTOR_REG_STOP,
        node->stop_mode,
        tx_frame,
        rx_frame,
        (uint16_t)sizeof(rx_frame),
        &tx_len,
        &rx_len);

    if (write_result == MOTOR_WRITE_ACK_OK)
    {
      node->trigger_stop_cmd = 0U;
      node->last_started_speed_rpm = 0;
      g_motor_internal.last_sent_speed_rpm[index] = 0;
      node->comm_ok = 1U;
    }
    else
    {
      node->trigger_stop_cmd = 1U;
      Motor_RecordSafetyWriteFailure(node, write_result);
    }

    g_motor_internal.last_cmd_tick[index] = now_tick;
    return;
  }

  /*
   * A driver can retain STOP across an MCU reset. Before any re-enable,
   * first prove the motor is released, then obtain an exact ACK for 0x0038=2.
   */
  if (limit_flow == MOTOR_LIMIT_FLOW_NORMAL &&
      g_motor_enable_write_cmd != 0U &&
      node->motor_enable != 0U &&
      node->run_restore_required != 0U)
  {
    if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
        MOTOR_CMD_MIN_INTERVAL_MS)
    {
      return;
    }

    if (node->applied_enable_known == 0U ||
        node->applied_enable != 0U ||
        g_motor_internal.last_motor_enable[index] != 0U)
    {
      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          MOTOR_REG_ENABLE,
          0U,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        g_motor_internal.last_motor_enable[index] = 0U;
        node->applied_enable = 0U;
        node->applied_enable_known = 1U;
        node->last_started_speed_rpm = 0;
        g_motor_internal.last_sent_speed_rpm[index] = 0;
        node->comm_ok = 1U;
      }
      else
      {
        node->applied_enable_known = 0U;
        node->run_restore_fail_count++;
        Motor_RecordSafetyWriteFailure(node, write_result);
      }
    }
    else
    {
      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          MOTOR_REG_STOP,
          MOTOR_STOP_CMD_RUN,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        node->run_restore_required = 0U;
        node->run_restore_acked = 1U;
        node->run_restore_ok_count++;
        node->comm_ok = 1U;
      }
      else
      {
        node->run_restore_required = 1U;
        node->run_restore_acked = 0U;
        node->run_restore_fail_count++;
        Motor_RecordSafetyWriteFailure(node, write_result);
      }
    }

    g_motor_internal.last_cmd_tick[index] = now_tick;
    return;
  }

  if (limit_flow == MOTOR_LIMIT_FLOW_NORMAL &&
      g_motor_enable_write_cmd != 0U)
  {
    /* Handle Manual Enable/Disable */
    if (node->motor_enable != g_motor_internal.last_motor_enable[index])
    {
      if ((now_tick - g_motor_internal.last_cmd_tick[index]) <
          MOTOR_CMD_MIN_INTERVAL_MS)
      {
        return;
      }

      taskENTER_CRITICAL();
      enable_cmd = node->motor_enable;
      command_sequence = node->command_sequence;
      taskEXIT_CRITICAL();
      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          MOTOR_REG_ENABLE,
          (enable_cmd != 0U) ? 1U : 0U,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        g_motor_internal.last_motor_enable[index] = enable_cmd;
        node->applied_enable = enable_cmd;
        node->applied_enable_known = 1U;
        if (enable_cmd == 0U)
        {
          node->last_started_speed_rpm = 0;
          g_motor_internal.last_sent_speed_rpm[index] = 0;
        }
        node->comm_ok = 1U;
      }
      else
      {
        node->applied_enable_known = 0U;
        Motor_RecordSafetyWriteFailure(node, write_result);
      }

      g_motor_internal.last_cmd_tick[index] = now_tick;
      return;
    }
  }


  if (limit_flow == MOTOR_LIMIT_FLOW_NORMAL &&
      g_motor_enable_write_cmd != 0U &&
      node->motor_enable != 0U &&
      g_motor_internal.last_motor_enable[index] != 0U &&
      node->run_restore_required == 0U)
  {
    if (node->trigger_pos_cmd != 0U &&
        (now_tick - g_motor_internal.last_cmd_tick[index]) >=
            MOTOR_CMD_MIN_INTERVAL_MS)
    {
      taskENTER_CRITICAL();
      position_pulses = node->pos_cmd_pulses;
      position_speed_rpm = node->pos_cmd_speed_rpm;
      position_is_absolute = node->pos_cmd_is_absolute;
      command_sequence = node->command_sequence;
      node->trigger_pos_cmd = 0U;
      taskEXIT_CRITICAL();

      if (position_speed_rpm == 0U)
      {
        Motor_FinishPositionTransaction(node);
        return;
      }

      if (position_is_absolute != 0U)
      {
        /* No fresh read-before-START exists, so absolute direction is unknown. */
        node->protocol_error_count++;
        g_motor_bus_diag.last_error = 22U;
        Motor_FinishPositionTransaction(node);
        return;
      }
      else
      {
        position_direction_speed_rpm =
            (position_pulses > 0)
                ? (int32_t)position_speed_rpm
                : ((position_pulses < 0)
                       ? -(int32_t)position_speed_rpm
                       : 0);
      }

      if (position_direction_speed_rpm == 0)
      {
        Motor_FinishPositionTransaction(node);
        return;
      }

      if (Motor_IsPositionIntentValid(
              node,
              position_pulses,
              position_speed_rpm,
              position_is_absolute,
              position_direction_speed_rpm,
              command_sequence) == 0U)
      {
        Motor_RequestStopAfterSpeedTransaction(
            node, position_direction_speed_rpm);
        return;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          MOTOR_REG_POS_PULSE_LOW,
          (uint16_t)((uint32_t)position_pulses & 0xFFFFU),
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);
      if (write_result != MOTOR_WRITE_ACK_OK ||
          Motor_IsPositionIntentValid(
              node,
              position_pulses,
              position_speed_rpm,
              position_is_absolute,
              position_direction_speed_rpm,
              command_sequence) == 0U)
      {
        if (write_result != MOTOR_WRITE_ACK_OK)
        {
          Motor_RecordSafetyWriteFailure(node, write_result);
        }
        Motor_RequestStopAfterSpeedTransaction(
            node, position_direction_speed_rpm);
        g_motor_internal.last_cmd_tick[index] = now_tick;
        return;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          MOTOR_REG_POS_PULSE_HIGH,
          (uint16_t)(((uint32_t)position_pulses >> 16) & 0xFFFFU),
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);
      if (write_result != MOTOR_WRITE_ACK_OK ||
          Motor_IsPositionIntentValid(
              node,
              position_pulses,
              position_speed_rpm,
              position_is_absolute,
              position_direction_speed_rpm,
              command_sequence) == 0U)
      {
        if (write_result != MOTOR_WRITE_ACK_OK)
        {
          Motor_RecordSafetyWriteFailure(node, write_result);
        }
        Motor_RequestStopAfterSpeedTransaction(
            node, position_direction_speed_rpm);
        g_motor_internal.last_cmd_tick[index] = now_tick;
        return;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          node->reg_map.reg_cmd_speed_rpm,
          position_speed_rpm,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);
      if (write_result != MOTOR_WRITE_ACK_OK ||
          Motor_IsPositionIntentValid(
              node,
              position_pulses,
              position_speed_rpm,
              position_is_absolute,
              position_direction_speed_rpm,
              command_sequence) == 0U)
      {
        if (write_result != MOTOR_WRITE_ACK_OK)
        {
          Motor_RecordSafetyWriteFailure(node, write_result);
        }
        Motor_RequestStopAfterSpeedTransaction(
            node, position_direction_speed_rpm);
        g_motor_internal.last_cmd_tick[index] = now_tick;
        return;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          MOTOR_REG_POS_MODE,
          position_is_absolute,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);
      if (write_result != MOTOR_WRITE_ACK_OK ||
          Motor_IsPositionIntentValid(
              node,
              position_pulses,
              position_speed_rpm,
              position_is_absolute,
              position_direction_speed_rpm,
              command_sequence) == 0U)
      {
        if (write_result != MOTOR_WRITE_ACK_OK)
        {
          Motor_RecordSafetyWriteFailure(node, write_result);
        }
        Motor_RequestStopAfterSpeedTransaction(
            node, position_direction_speed_rpm);
        g_motor_internal.last_cmd_tick[index] = now_tick;
        return;
      }

      position_start_cmd =
          (position_is_absolute != 0U)
              ? MOTOR_CMD_START_ABS_POS
              : MOTOR_CMD_START_REL_POS;
      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          node->reg_map.reg_cmd_start,
          position_start_cmd,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        node->last_started_speed_rpm = position_direction_speed_rpm;
        node->tx_count++;
        node->comm_ok = 1U;
        if (Motor_IsPositionIntentValid(
                node,
                position_pulses,
                position_speed_rpm,
                position_is_absolute,
                position_direction_speed_rpm,
                command_sequence) == 0U)
        {
          Motor_RequestStopAfterSpeedTransaction(
              node, position_direction_speed_rpm);
        }
      }
      else
      {
        /* Position START may also have executed before its ACK was lost. */
        node->last_started_speed_rpm = position_direction_speed_rpm;
        Motor_RecordSafetyWriteFailure(node, write_result);
        Motor_RequestStopAfterSpeedTransaction(
            node, position_direction_speed_rpm);
      }

      Motor_FinishPositionTransaction(node);
      g_motor_internal.last_cmd_tick[index] = now_tick;
      return;
    }
  }

  if ((limit_flow == MOTOR_LIMIT_FLOW_NORMAL) &&
      (g_motor_enable_write_cmd != 0U) &&
      (node->motor_enable != 0U) &&
      (g_motor_internal.last_motor_enable[index] != 0U) &&
      (node->enable_speed_ctrl != 0U) &&
      ((now_tick - g_motor_internal.last_cmd_tick[index]) >= MOTOR_CMD_MIN_INTERVAL_MS))
  {
    if (g_motor_internal.last_sent_speed_rpm[index] != node->target_speed_rpm)
    {
      taskENTER_CRITICAL();
      speed_cmd = (int16_t)node->target_speed_rpm;
      command_sequence = node->command_sequence;
      possible_speed_rpm = node->last_started_speed_rpm;
      taskEXIT_CRITICAL();

      if (Motor_IsNormalSpeedIntentValid(
              node, (int32_t)speed_cmd, command_sequence) == 0U)
      {
        if (Motor_IsNodeDirectionBlocked(
                node, (int32_t)speed_cmd) != 0U)
        {
          possible_speed_rpm = (int32_t)speed_cmd;
        }
        Motor_RequestStopAfterSpeedTransaction(
            node, possible_speed_rpm);
        return;
      }

      write_result = Motor_WriteSingleRegisterExact(
          node_id,
          node->reg_map.reg_cmd_speed_rpm,
          (uint16_t)speed_cmd,
          tx_frame,
          rx_frame,
          (uint16_t)sizeof(rx_frame),
          &tx_len,
          &rx_len);

      if (write_result == MOTOR_WRITE_ACK_OK)
      {
        /* The speed register is written, but START has not been sent yet. */
        if (Motor_IsNormalSpeedIntentValid(
                node, (int32_t)speed_cmd, command_sequence) == 0U)
        {
          g_motor_internal.last_sent_speed_rpm[index] =
              (int32_t)speed_cmd;
          if (Motor_IsNodeDirectionBlocked(
                  node, (int32_t)speed_cmd) != 0U)
          {
            possible_speed_rpm = (int32_t)speed_cmd;
          }
          Motor_RequestStopAfterSpeedTransaction(
              node, possible_speed_rpm);
          g_motor_internal.last_cmd_tick[index] = now_tick;
          return;
        }

        write_result = Motor_WriteSingleRegisterExact(
            node_id,
            node->reg_map.reg_cmd_start,
            node->reg_map.cmd_start_speed_mode_value,
            tx_frame,
            rx_frame,
            (uint16_t)sizeof(rx_frame),
            &tx_len,
            &rx_len);

        if (write_result == MOTOR_WRITE_ACK_OK)
        {
          g_motor_internal.last_sent_speed_rpm[index] =
              (int32_t)speed_cmd;
          node->last_started_speed_rpm = (int32_t)speed_cmd;
          node->tx_count++;
          node->comm_ok = 1U;
          node->last_exception_func = 0U;
          node->last_exception_code = 0U;

          /* START may complete while enable/target/limit changes. */
          if (Motor_IsNormalSpeedIntentValid(
                  node, (int32_t)speed_cmd, command_sequence) == 0U)
          {
            Motor_RequestStopAfterSpeedTransaction(
                node, (int32_t)speed_cmd);
          }
        }
        else
        {
          /* START may have executed even when its ACK was lost. */
          if (Motor_IsNodeDirectionBlocked(
                  node, (int32_t)speed_cmd) != 0U ||
              (Motor_IsNodeDirectionBlocked(
                   node, possible_speed_rpm) == 0U &&
               speed_cmd != 0))
          {
            possible_speed_rpm = (int32_t)speed_cmd;
          }
          g_motor_internal.last_sent_speed_rpm[index] =
              (int32_t)speed_cmd;
          node->last_started_speed_rpm = possible_speed_rpm;
          Motor_RecordSafetyWriteFailure(node, write_result);
          Motor_RequestStopAfterSpeedTransaction(
              node, possible_speed_rpm);
        }
      }
      else
      {
        Motor_RecordSafetyWriteFailure(node, write_result);
        Motor_RequestStopAfterSpeedTransaction(
            node, possible_speed_rpm);
      }

      g_motor_internal.last_cmd_tick[index] = now_tick;
    }
  }

  if ((node->enable_poll != 0U) &&
      ((now_tick - g_motor_internal.last_poll_tick[index]) >= MOTOR_POLL_INTERVAL_MS))
  {
    poll_ok = 0U;
    dbg->poll_last_stage = 1U;

    req_start_reg = node->reg_map.verify_read_start_reg;
    req_count = node->reg_map.verify_read_reg_count;
    tx_len = Motor_BuildReadStatusFrame(node_id, req_start_reg, req_count, tx_frame);
    memcpy((void *)dbg->poll_last_tx_frame, (const void *)tx_frame, 8U);
    dbg->poll_last_req_start_reg = req_start_reg;
    dbg->poll_last_req_reg_count = req_count;

    if (Motor_Transfer(tx_frame, tx_len, rx_frame, (uint16_t)sizeof(rx_frame), &rx_len) != 0U &&
        Motor_ParseReadBlockResponse(node_id,
                                     rx_frame,
                                     rx_len,
                                     req_count,
                                     block_words,
                                     &got_regs) != 0U)
    {
      dbg->poll_last_rsp_len = rx_len;
      dbg->poll_last_rsp_reg_count = got_regs;
      memcpy((void *)dbg->poll_last_rx_frame, (const void *)rx_frame,
             (rx_len > UMOTOR_NODE_DEBUG_RX_MAX) ? UMOTOR_NODE_DEBUG_RX_MAX : rx_len);

      copy_count = (got_regs > UMOTOR_MAX_READ_REG_COUNT) ? UMOTOR_MAX_READ_REG_COUNT : got_regs;
      memcpy((void *)node->verify_regs, (const void *)block_words, copy_count * sizeof(uint16_t));

      dbg->reg_0014_node_id_cfg = (got_regs >= 1U) ? block_words[0U] : 0U;
      dbg->reg_0015_baud_cfg = (got_regs >= 2U) ? block_words[1U] : 0U;
      dbg->baud_rate_bps = Motor_BaudCodeToBps(dbg->reg_0015_baud_cfg);
      dbg->reg_0016_uart_fmt_cfg = (got_regs >= 3U) ? block_words[2U] : 0U;
      dbg->reg_0017_save_cmd = (got_regs >= 4U) ? block_words[3U] : 0U;

      poll_ok = 1U;
    }
    else if (Motor_ParseExceptionResponse(node_id, rx_frame, rx_len, &exception_func, &exception_code) != 0U)
    {
      node->protocol_error_count++;
      node->valid = 0U;
      node->comm_ok = 1U;
      node->last_exception_func = (uint32_t)exception_func;
      node->last_exception_code = (uint32_t)exception_code;
      g_motor_bus_diag.last_exception_func = (uint32_t)exception_func;
      g_motor_bus_diag.last_exception_code = (uint32_t)exception_code;
      g_motor_bus_diag.last_error = 12U;
      poll_ok = 0U;
    }

    if (poll_ok != 0U)
    {
      dbg->poll_last_stage = 2U;
      if (node->reg_map.status_read_reg_count != 0U)
      {
        req_start_reg = node->reg_map.status_read_start_reg;
        req_count = node->reg_map.status_read_reg_count;
        tx_len = Motor_BuildReadStatusFrame(node_id, req_start_reg, req_count, tx_frame);
        memcpy((void *)dbg->poll_last_tx_frame, (const void *)tx_frame, 8U);
        dbg->poll_last_req_start_reg = req_start_reg;
        dbg->poll_last_req_reg_count = req_count;

        if (Motor_Transfer(tx_frame, tx_len, rx_frame, (uint16_t)sizeof(rx_frame), &rx_len) != 0U &&
            Motor_ParseReadBlockResponse(node_id,
                                         rx_frame,
                                         rx_len,
                                         req_count,
                                         block_words,
                                         &got_regs) != 0U)
        {
          dbg->poll_last_rsp_len = rx_len;
          dbg->poll_last_rsp_reg_count = got_regs;
          memcpy((void *)dbg->poll_last_rx_frame, (const void *)rx_frame,
                 (rx_len > UMOTOR_NODE_DEBUG_RX_MAX) ? UMOTOR_NODE_DEBUG_RX_MAX : rx_len);

          copy_count = (got_regs > UMOTOR_MAX_READ_REG_COUNT) ? UMOTOR_MAX_READ_REG_COUNT : got_regs;
          memcpy((void *)node->status_regs, (const void *)block_words, copy_count * sizeof(uint16_t));

          dbg->reg_0000_driver_version = (got_regs >= 1U) ? block_words[0U] : 0U;
          dbg->reg_0001_driver_model = (got_regs >= 2U) ? block_words[1U] : 0U;
          dbg->reg_0002_node_id_runtime = (got_regs >= 3U) ? block_words[2U] : 0U;
          dbg->reg_0003_work_mode = (got_regs >= 4U) ? block_words[3U] : 0U;
          dbg->reg_0004_status = (got_regs >= 5U) ? block_words[4U] : 0U;
          dbg->reg_0005_target_speed = (got_regs >= 6U) ? block_words[5U] : 0U;
          dbg->reg_0006_actual_speed = (got_regs >= 7U) ? block_words[6U] : 0U;
          dbg->reg_0007_error_code = (got_regs >= 8U) ? block_words[7U] : 0U;
          dbg->reg_0008_error_subcode = (got_regs >= 9U) ? block_words[8U] : 0U;
          dbg->reg_000B_pos_low = (got_regs >= 12U) ? block_words[11U] : 0U;
          dbg->reg_000C_pos_high = (got_regs >= 13U) ? block_words[12U] : 0U;
          dbg->pos_signed_32 = (int32_t)(((uint32_t)dbg->reg_000C_pos_high << 16) | dbg->reg_000B_pos_low);

          node->status_word = dbg->reg_0004_status;
          node->feedback_speed_rpm = (int32_t)(int16_t)dbg->reg_0006_actual_speed;
        }
        else
        {
          poll_ok = 0U;
        }
      }
      else
      {
        /* Status read disabled by config. */
      }
    }

    if (poll_ok != 0U)
    {
      dbg->poll_last_stage = 3U;
      if (node->reg_map.fault_read_reg_count != 0U)
      {
        req_start_reg = node->reg_map.fault_read_start_reg;
        req_count = node->reg_map.fault_read_reg_count;
        tx_len = Motor_BuildReadStatusFrame(node_id, req_start_reg, req_count, tx_frame);
        memcpy((void *)dbg->poll_last_tx_frame, (const void *)tx_frame, 8U);
        dbg->poll_last_req_start_reg = req_start_reg;
        dbg->poll_last_req_reg_count = req_count;

        if (Motor_Transfer(tx_frame, tx_len, rx_frame, (uint16_t)sizeof(rx_frame), &rx_len) != 0U &&
            Motor_ParseReadBlockResponse(node_id,
                                         rx_frame,
                                         rx_len,
                                         req_count,
                                         block_words,
                                         &got_regs) != 0U)
        {
          dbg->poll_last_rsp_len = rx_len;
          dbg->poll_last_rsp_reg_count = got_regs;
          memcpy((void *)dbg->poll_last_rx_frame, (const void *)rx_frame,
                 (rx_len > UMOTOR_NODE_DEBUG_RX_MAX) ? UMOTOR_NODE_DEBUG_RX_MAX : rx_len);

          copy_count = (got_regs > UMOTOR_MAX_READ_REG_COUNT) ? UMOTOR_MAX_READ_REG_COUNT : got_regs;
          memcpy((void *)node->fault_regs, (const void *)block_words, copy_count * sizeof(uint16_t));

          dbg->reg_0194_latest_fault = (got_regs >= 1U) ? block_words[0U] : 0U;
          dbg->reg_0195_latest_fault_sub = (got_regs >= 2U) ? block_words[1U] : 0U;
          dbg->reg_0196_second_fault = (got_regs >= 3U) ? block_words[2U] : 0U;
          dbg->reg_0197_second_fault_sub = (got_regs >= 4U) ? block_words[3U] : 0U;
          dbg->reg_0198_third_fault = (got_regs >= 5U) ? block_words[4U] : 0U;
          dbg->reg_0199_third_fault_sub = (got_regs >= 6U) ? block_words[5U] : 0U;
          dbg->reg_019A_comm_fault_bits = (got_regs >= 7U) ? block_words[6U] : 0U;
        }
        else
        {
          poll_ok = 0U;
        }
      }
      else
      {
        /* Fault read disabled by config. */
      }
    }

    if (poll_ok != 0U)
    {
      status_word = dbg->reg_0004_status;
      feedback_speed = (int16_t)dbg->reg_0006_actual_speed;

      node->status_word = status_word;
      node->feedback_speed_rpm = (int32_t)feedback_speed;
      node->valid = 1U;
      node->comm_ok = 1U;
      node->rx_count++;
      dbg->poll_ok_count++;
      node->last_exception_func = 0U;
      node->last_exception_code = 0U;
    }
    else
    {
      node->valid = 0U;
      node->comm_ok = 0U;
      if (g_motor_bus_diag.last_error == 3U)
      {
        node->timeout_count++;
      }
      else if (g_motor_bus_diag.last_error == 10U ||
               g_motor_bus_diag.last_error == 19U)
      {
        node->crc_error_count++;
      }
      else if (g_motor_bus_diag.last_error == 1U ||
               g_motor_bus_diag.last_error == 2U ||
               g_motor_bus_diag.last_error == 20U)
      {
        node->transport_error_count++;
      }
      else if (g_motor_bus_diag.last_error != 12U)
      {
        node->protocol_error_count++;
      }
      dbg->poll_fail_count++;
    }

    g_motor_internal.last_poll_tick[index] = now_tick;
  }
}

void UMotor_StartTask(void *argument)
{
  uint32_t now_tick;
  uint8_t index;

  (void)argument;
  g_motor_internal.initialized = 1U;
  g_motor_bus_diag.initialized = 1U;

  /* Hardware enable state is unknown after an MCU-only reset. */
  for (index = 0U; index < MOTOR_BUS_MAX_NODES; index++)
  {
    g_motor_internal.last_motor_enable[index] = 0xFFU;
    g_motor_nodes[index].applied_enable = 0U;
    g_motor_nodes[index].applied_enable_known = 0U;
    g_motor_nodes[index].run_restore_required = 1U;
    g_motor_nodes[index].run_restore_acked = 0U;
  }

  /* ====== 测试代码：启动自动使能 ====== */
  /* 取消注释以下代码可开机自动转动测试 */
  /*
  g_umotor.enable_write_cmd = 1U; 
  UMotor_SetMotorEnable(0, 1U);   
  
  uint32_t last_test_tick = osKernelGetTickCount();
  uint8_t test_direction = 0U;
  */
  /* ===================================================== */

  for (;;)
  {
    now_tick = osKernelGetTickCount();
    g_motor_bus_diag.loop_count++;

    /* 测试：每8秒来回以100RPM转10圈 */
    /*
    if (now_tick - last_test_tick > 8000U)
    {
      last_test_tick = now_tick;
      if (test_direction == 0U)
      {
        UMotor_RunPosition(0, 100000, 100U, 1U); 
        test_direction = 1U;
      }
      else
      {
        UMotor_RunPosition(0, 0, 100U, 1U);     
        test_direction = 0U;
      }
    }
    */

    Motor_UpdateActiveNodeCount();
    Motor_ProcessOneNode(g_motor_internal.rr_index, now_tick);

    g_motor_internal.rr_index++;
    if (g_motor_internal.rr_index >= MOTOR_BUS_MAX_NODES)
    {
      g_motor_internal.rr_index = 0U;
    }

    osDelay(MOTOR_TASK_PERIOD_MS);
  }
}

/* Set enable state manually */
void UMotor_SetMotorEnable(uint8_t index, uint8_t enable)
{
  uint8_t enable_value;

  if (index < MOTOR_BUS_MAX_NODES)
  {
    enable_value = (enable != 0U) ? 1U : 0U;
    taskENTER_CRITICAL();
    if (g_umotor.nodes[index].motor_enable != enable_value)
    {
      g_umotor.nodes[index].motor_enable = enable_value;
      g_umotor.nodes[index].command_sequence++;
    }
    if (enable_value == 0U)
    {
      g_umotor.nodes[index].limit_ack_required_mask = 0U;
      g_umotor.nodes[index].trigger_pos_cmd = 0U;
      g_umotor.nodes[index].position_transaction_active = 0U;
      g_umotor.nodes[index].position_command_latched = 0U;
    }
    taskEXIT_CRITICAL();
  }
}

/* Stop motor manually */

void UMotor_StopMotor(uint8_t index, uint16_t stop_mode)
{
  if (index < MOTOR_BUS_MAX_NODES)
  {
    taskENTER_CRITICAL();
    if (g_umotor.nodes[index].target_speed_rpm != 0 ||
        g_umotor.nodes[index].trigger_stop_cmd == 0U ||
        g_umotor.nodes[index].stop_mode != (uint8_t)stop_mode)
    {
      g_umotor.nodes[index].command_sequence++;
    }
    g_umotor.nodes[index].target_speed_rpm = 0;
    g_umotor.nodes[index].limit_ack_required_mask = 0U;
    g_umotor.nodes[index].position_transaction_active = 0U;
    g_umotor.nodes[index].position_command_latched = 0U;
    g_umotor.nodes[index].trigger_pos_cmd = 0U;
    g_umotor.nodes[index].stop_mode = (uint8_t)stop_mode;
    g_umotor.nodes[index].trigger_stop_cmd = 1U;
    if (stop_mode != MOTOR_STOP_CMD_RUN)
    {
      g_umotor.nodes[index].run_restore_required = 1U;
      g_umotor.nodes[index].run_restore_acked = 0U;
    }
    taskEXIT_CRITICAL();
  }
}

/* Trigger position run */
void UMotor_RunPosition(uint8_t index, int32_t pulses, uint16_t rpm, uint8_t is_absolute)
{
  uint8_t absolute_value;

  if (rpm > 32767U)
  {
    rpm = 32767U;
  }

  if (index < MOTOR_BUS_MAX_NODES)
  {
    absolute_value = (is_absolute != 0U) ? 1U : 0U;
    taskENTER_CRITICAL();
    if (absolute_value != 0U)
    {
      g_umotor.nodes[index].protocol_error_count++;
      g_motor_bus_diag.last_error = 22U;
      taskEXIT_CRITICAL();
      return;
    }
    if (g_umotor.nodes[index].limit_state !=
            UMOTOR_LIMIT_STATE_NORMAL ||
        g_umotor.nodes[index].limit_event_pending != 0U)
    {
      g_umotor.nodes[index].protocol_error_count++;
      g_motor_bus_diag.last_error = 23U;
      taskEXIT_CRITICAL();
      return;
    }
    if (g_umotor.nodes[index].position_transaction_active != 0U ||
        (g_umotor.nodes[index].position_command_latched != 0U &&
         g_umotor.nodes[index].pos_cmd_pulses == pulses &&
         g_umotor.nodes[index].pos_cmd_speed_rpm == rpm &&
         g_umotor.nodes[index].pos_cmd_is_absolute == absolute_value))
    {
      taskEXIT_CRITICAL();
      return;
    }
    g_umotor.nodes[index].command_sequence++;
    g_umotor.nodes[index].pos_cmd_pulses = pulses;
    g_umotor.nodes[index].pos_cmd_speed_rpm = rpm;
    g_umotor.nodes[index].pos_cmd_is_absolute = absolute_value;
    g_umotor.nodes[index].trigger_pos_cmd = 1U;
    g_umotor.nodes[index].position_transaction_active = 1U;
    g_umotor.nodes[index].position_command_latched = 1U;
    taskEXIT_CRITICAL();
  }
}

#endif /* 归档备份：整份禁用 */
