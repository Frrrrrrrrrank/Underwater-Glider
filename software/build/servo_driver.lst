  13:Glider-Core/servo_driver.c **** /* === Servo Debug Global Variable ===
  14:Glider-Core/servo_driver.c ****  * Default configuration:
  15:Glider-Core/servo_driver.c ****  * - Physical mapping: 0° -> 500µs, 270° -> 1315µs (calibrated from datasheet)
  16:Glider-Core/servo_driver.c ****  * - Sweep range: full 0-270° for mode 0 operation
  17:Glider-Core/servo_driver.c ****  * - Angular speed: 60 deg/s
  18:Glider-Core/servo_driver.c ****  */
  19:Glider-Core/servo_driver.c **** volatile ServoDebugView g_servo_debug = {
  20:Glider-Core/servo_driver.c ****   0U,     /* pwm_started */
