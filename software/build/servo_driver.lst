  22:Glider-Core/servo_driver.c ****   135.0f, /* cmd_angle_deg */
  23:Glider-Core/servo_driver.c ****   135.0f, /* current_angle_deg */
  24:Glider-Core/servo_driver.c ****   0.0f,   /* min_angle_deg (actual angle: 0°) */
  25:Glider-Core/servo_driver.c ****   270.0f, /* max_angle_deg (actual angle: 270°) */
  26:Glider-Core/servo_driver.c ****   908U,   /* current_pulse_us (actual 135° with calibrated range) */
  27:Glider-Core/servo_driver.c ****   500U,   /* min_pulse_us (calibrated actual 0°) */
  28:Glider-Core/servo_driver.c ****   908U,   /* center_pulse_us (display/reference only) */
  29:Glider-Core/servo_driver.c ****   1315U,  /* max_pulse_us (calibrated actual 270° from test) */
  30:Glider-Core/servo_driver.c ****   60.0f,  /* sweep_speed_deg_s */
