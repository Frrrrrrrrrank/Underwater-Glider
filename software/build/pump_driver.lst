 519:Glider-Core/pump_driver.c ****   /* Speed control: Right outer switch DOWN (value ~240) pulls M0 LOW (PB10) */
 520:Glider-Core/pump_driver.c ****   if (right_outer_switch < 500U)  /* Down position */
 521:Glider-Core/pump_driver.c ****   {
 522:Glider-Core/pump_driver.c ****     IoControlPump_SetSpeed(1U);  /* Pull M0 LOW */
 523:Glider-Core/pump_driver.c ****     g_io_pump_debug.speed_triggered = 1U;
 524:Glider-Core/pump_driver.c ****   }
 525:Glider-Core/pump_driver.c ****   else
 526:Glider-Core/pump_driver.c ****   {
 527:Glider-Core/pump_driver.c ****     IoControlPump_SetSpeed(0U);  /* Release M0 to HIGH */
 528:Glider-Core/pump_driver.c ****     g_io_pump_debug.speed_triggered = 0U;
 529:Glider-Core/pump_driver.c ****   }
 530:Glider-Core/pump_driver.c **** 
 531:Glider-Core/pump_driver.c ****   /* Direction control: Left-mid-2 switch in MIDDLE position (~1024) pulls CW/CCW LOW (PD14) */
 532:Glider-Core/pump_driver.c ****   if (left_mid2_switch > mid_low && left_mid2_switch < mid_high)
 533:Glider-Core/pump_driver.c ****   {
 534:Glider-Core/pump_driver.c ****     IoControlPump_SetDirection(1U);  /* Pull CW/CCW LOW - reverse direction */
 535:Glider-Core/pump_driver.c ****     g_io_pump_debug.direction_reversed = 1U;
 536:Glider-Core/pump_driver.c ****   }
 537:Glider-Core/pump_driver.c ****   else
 538:Glider-Core/pump_driver.c ****   {
 539:Glider-Core/pump_driver.c ****     IoControlPump_SetDirection(0U);  /* Release CW/CCW to HIGH - normal direction */
 540:Glider-Core/pump_driver.c ****     g_io_pump_debug.direction_reversed = 0U;
 541:Glider-Core/pump_driver.c ****   }
 542:Glider-Core/pump_driver.c **** }
